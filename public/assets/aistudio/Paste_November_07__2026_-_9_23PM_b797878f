const doDelete = async (m: any, deleteForEveryone: boolean) => {
  if (!currentUserId) return;
  try {
    await apiFetch(
      `/api/messages/${safeNum(m?.id)}`,
      {
        method: "DELETE",
        body: JSON.stringify({ delete_for_everyone: deleteForEveryone, user_id: currentUserId }),
