### 7.2 Send a call signal (`POST /api/calls/signal`)

**`Chat.tsx` — `sendSignal()`:**

```tsx
const sendSignal = async (cid: string, toUserId: number, type: string, payload?: any) => {
  await apiFetch(
    "/api/calls/signal",
    {
      method: "POST",
      body: JSON.stringify({
        call_id: cid,
        to_user_id: toUserId,
        type,
        payload: payload ?? null,
      }),
    },
    currentUserId
  );
};
```

### Request body

```json
POST /api/calls/signal
{
  "call_id": "call_1705000000_42_15",
  "to_user_id": 15,
  "type": "offer" | "answer" | "ice" | "accept" | "decline" | "hangup",
  "payload": { ... }
}
```

### Signal types and when they're sent

| `type` | Sent when | `payload` |
|---|---|---|
| **`offer`** | Caller — right after creating the call & setting local description | WebRTC `RTCSessionDescription` (SDP offer) |
| **`answer`** | Callee — after receiving offer & creating answer | WebRTC `RTCSessionDescription` (SDP answer) |
| **`ice`** | Both peers — each time `pc.onicecandidate` fires with a candidate | `{ candidate, sdpMid, sdpMLineIndex, ... }` |
| **`accept`** | Callee — the moment they tap "Accept" | `{ ok: true }` |
| **`decline`** | Callee — the moment they tap "Decline" | `{ reason: "declined" }` |
| **`hangup`** | Either party — when ending the call | `{ ok: true }` |

---

### 7.3 Poll for incoming signals (`GET /api/calls/poll?call_id=&after=`)

**`Chat.tsx` — `startPollingCallEvents()`:**

```tsx
const startPollingCallEvents = (cid: string) => {
  if (callPollRef.current) window.clearInterval(callPollRef.current);
  callPollRef.current = window.setInterval(async () => {
    try {
      const after = callCursorRef.current || 0;
      const res = await apiFetch(`/api/calls/poll?call_id=${encodeURIComponent(cid)}&after=${after}`, {}, currentUserId);
      const events = Array.isArray(res?.events) ? res.events : [];
      const cursor = Number(res?.cursor ?? after);
      if (Number.isFinite(cursor)) {
        callCursorRef.current = cursor;
        setCallCursor(cursor);
      }
      for (const ev of events) await handleCallEvent(ev);
    } catch {}
  }, 900);
};
```

Runs every **900ms** while a call is open. Uses a cursor (`after`) to receive only **new** events.

### Response shape

```json
GET /api/calls/poll?call_id=call_1705000000_42_15&after=5
{
  "events": [
    {
      "seq": 6,
      "type": "answer",
      "payload": { "type": "answer", "sdp": "v=0\r\n..." }
    },
    {
      "seq": 7,
      "type": "ice",
      "payload": { "candidate": "candidate:...", "sdpMid": "0", "sdpMLineIndex": 0 }
    }
  ],
  "cursor": 7
}
```

The client sets `callCursorRef.current = res.cursor` so the next poll asks for events after `7`.

### `handleCallEvent()` — what the client does with each event

```tsx
const handleCallEvent = async (ev: any) => {
  const type = String(ev?.type || "");
  const payload = ev?.payload ?? null;
  const pc = peerConnectionRef.current;

  if (type === "accept") { setCallPhase("connecting"); return; }
  if (type === "decline") {
    callEndReasonRef.current = "declined";
    if (callIdRef.current) await logMissedOnce(callIdRef.current, { mode: callMode, direction: "outgoing" });
    stopRingtone(); setCallOpen(false); setCallPhase("ended"); endCall(true);
    return;
  }
  if (type === "hangup") { stopRingtone(); endCall(true); return; }
  if (!pc) return;

  if (type === "offer") {
    const otherId = safeNum(callPeerIdRef.current) || safeNum(incomingPopupRef.current?.caller_id) || safeNum(incomingPopupRef.current?.callee_id) || 0;
    const cid = String(callIdRef.current || incomingPopupRef.current?.id || "");
    if (!cid || !otherId) return;
    await pc.setRemoteDescription(new RTCSessionDescription(payload));
    remoteDescSetRef.current = true;
    await flushPendingIce(pc);
    const answer = await pc.createAnswer();
    await pc.setLocalDescription(answer);
    await sendSignal(cid, otherId, "answer", answer);
    setCallPhase("connecting");
    return;
  }

  if (type === "answer") {
    if (!pc.currentRemoteDescription) {
      await pc.setRemoteDescription(new RTCSessionDescription(payload));
      remoteDescSetRef.current = true;
    }
    await flushPendingIce(pc);
    setCallPhase("connecting");
    return;
  }

  if (type === "ice") {
    if (!remoteDescSetRef.current) { pendingIceRef.current.push(payload); return; }
    try { await pc.addIceCandidate(new RTCIceCandidate(payload)); } catch {}
  }
};
```

