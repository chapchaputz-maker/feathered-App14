## 4. Mark one notification as read

Neither `NotificationDropdown.tsx` nor `NotificationsPage.tsx` calls this endpoint directly. It lives in **`App.tsx`** and is invoked indirectly when the user clicks a notification:

**`App.tsx` — inside `openNotificationTarget()`:**

```tsx
const markAsRead = async () => {
  try {
    await fetch(`/api/notifications/${notification.id}/read`, {
      method: 'POST',
      headers: {
        ...(currentUser?.id ? { "x-user-id": String(currentUser.id) } : {}),
      },
    });
    setNotifications(prev =>
      prev.map(n =>
        Number(n.id) === Number(notification.id) ? { ...n, is_read: 1 } : n
      )
    );
  } catch (error) {
    console.error('Failed to mark notification as read:', error);
  }
};
```

**Endpoint:**

```
POST /api/notifications/{notificationId}/read
x-user-id: <currentUserId>
```

**No body.**

**In `NotificationsPage.tsx`, `handleOpenNotification` optimistically flips `is_read` locally but does not call this endpoint itself** — the parent `App.tsx` handler is what actually POSTs:

```tsx
const handleOpenNotification = (n: Notification) => {
    // Mark as read locally when opened
    if (!safeNumber(n.is_read, 0)) {
      setLocalNotifications((prev) =>
        prev.map((item) =>
          safeNumber(item.id, 0) === safeNumber(n.id, 0)
            ? { ...item, is_read: 1 }
            : item
        )
      );
    }

    if (onOpenNotification) {
      onOpenNotification(n);
      return;
    }

    const actorId = safeNumber(n.actor_id, 0);
    if (actorId) onProfileClick(actorId);
};
```

